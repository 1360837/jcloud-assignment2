diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index f15f57648..51fb2dcdd 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -77,6 +77,7 @@ unsigned int sysctl_sched_tunable_scaling = SCHED_TUNABLESCALING_LOG;
  * (default: 0.70 msec * (1 + ilog(ncpus)), units: nanoseconds)
  */
 unsigned int sysctl_sched_base_slice			= 700000ULL;
+unsigned int sysctl_sched_nice_slice			= 0;
 static unsigned int normalized_sysctl_sched_base_slice	= 700000ULL;
 
 __read_mostly unsigned int sysctl_sched_migration_cost	= 500000UL;
@@ -1234,7 +1235,25 @@ static void clear_buddies(struct cfs_rq *cfs_rq, struct sched_entity *se);
 /*
  * XXX: strictly: vd_i += N*r_i/w_i such that: vd_i > ve_i
  * this is probably good enough.
+ *
+ *
  */
+static u64 sp_request_size(struct sched_entity *se)
+{
+	u64 slice = sysctl_sched_base_slice;
+
+	if (sysctl_sched_nice_slice && entity_is_task(se)) {
+		int nice = task_nice(task_of(se));
+
+		if (nice < 0)
+			slice /= 2;
+		else if (nice > 0)
+			slice *= 2;
+	}
+
+	return clamp_t(u64, slice, 100000ULL, 20000000ULL);
+}
